// DELIBERATELY BROKEN. The seat gate reading a usage record again.
//
// This is the P7 defect `internal/seats` and `entitlement.stateMetrics` were written to undo, restored
// in the two ways it can come back:
//
//   1. `stateMetrics` no longer classifies the seat meter as a STATE, so `measure` falls through to
//      `observed` — the usage store — for it.
//   2. A call site reads the seat quantity straight out of usage.
//
// Either one is enough. The comparison then runs against a number nothing writes at membership time, so
// it is a permanent zero: a plan that sells five seats admits five hundred, and nothing fails.
package broken

import "github.com/heros-foreal/agentd/internal/metering"

// The seat entry is gone. Everything else looks untouched.
var stateMetrics = map[metering.Metric]bool{}

func (g *Gate) seatsUsed(customerID string) float64 {
	return g.observed(customerID, metering.MetricSeats)
}
