# Example environment for deploy/docker-compose.platform.yml (P19 deployment-topology).
#
# 🔴 THIS FILE CARRIES NO SECRETS AND NEVER WILL. It documents the NAMES the platform reads and the
# shape of each value. Secret values come from the deployment's secret store, injected at start; a real
# credential committed to a repository outlives the moment it was valid, and it ships.
#
#   cp deploy/.env.platform.example deploy/.env.platform      # then fill from your secret store
#   cp deploy/images.env deploy/.env.images                   # the digest-pinned image set (D2)
#   docker compose --env-file deploy/.env.images --env-file deploy/.env.platform \
#     -f deploy/docker-compose.platform.yml up -d
#
# The `${VAR:?...}` entries in the compose file REFUSE TO START when unset — an unset required secret
# is a process that does not come up, not a stack that comes up misconfigured and fails later somewhere
# less obvious (deployment-topology: "a missing secret refuses to start").

# ── Published ports on the host (origins, not credentials) ──────────────────────────────────────────
AGENTD_PORT=4321
CONSOLE_PORT=4320

# ── Secret source for the platform's own model calls (platform-llm-access) ──────────────────────────
# The seam the P4/P4.5/P5.5/P6 stages resolve provider credentials through, selected here.
#   env                  process environment (OPENAI_API_KEY / ANTHROPIC_API_KEY / AWS_*). Dev/compose.
#   aws-secrets-manager  reached with an AMBIENT identity (instance role / IRSA) — NO bootstrap secret.
#   (air-gapped)         point the on-prem gateway at HEROS_SECRETS_HEALTH_URL; see the airgapped overlay.
HEROS_SECRETS_SOURCE=env
# Optional, for aws-secrets-manager: region and provider->secret-ID mapping (mapping is CONFIG, not code).
# HEROS_SECRETS_AWS_REGION=us-east-1
# HEROS_SECRETS_AWS_PREFIX=heros/prod/
# HEROS_SECRETS_AWS_IDS=openai=heros/prod/openai,anthropic=heros/prod/anthropic
# Optional: an on-prem-gateway reachability URL. When set, /readyz aggregates secrets_source and reports
# it degraded (fail-static) when the gateway is unreachable. Leave unset for env/AWS.
# HEROS_SECRETS_HEALTH_URL=http://onprem-llm-gateway:8080/healthz

# Provider credentials for HEROS_SECRETS_SOURCE=env (compose/dev only). Inject from your secret store;
# leave BLANK here. With no provider credential the model-dependent stages report degraded-not-available
# and the rest of the platform stays fully functional.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Postgres (the stateful store; single-writer SPOF — see deploy/README.md §Backups) ───────────────
POSTGRES_DB=heros
POSTGRES_USER=heros
# 🔴 Inject from your secret store. Unset => compose refuses to start.
POSTGRES_PASSWORD=
# Backup schedule (cron form) and retention for the backup service.
POSTGRES_BACKUP_CRON=17 3 * * *
POSTGRES_BACKUP_RETENTION_DAYS=14

# ── Object store (MinIO) ────────────────────────────────────────────────────────────────────────────
OBJECT_STORE_ROOT_USER=heros
# 🔴 Inject from your secret store. Unset => compose refuses to start.
OBJECT_STORE_ROOT_PASSWORD=

# ── Graph store (Neo4j) ─────────────────────────────────────────────────────────────────────────────
# Neo4j reads a combined "user/password" auth string. Format: neo4j/<password>.
# 🔴 Inject from your secret store. Unset => compose refuses to start.
NEO4J_AUTH=

# ── Customer console BFF (P9) ───────────────────────────────────────────────────────────────────────
# The BFF's OWN credential for the platform API. The browser never receives it; it appears in no client
# bundle, log line or trace attribute. 🔴 Inject from your secret store. Unset => refuse to start.
CONSOLE_PLATFORM_CREDENTIAL=
# The tenant identity seam (ADR-008). `configured` reads the assertion->tenant map; `dev` REFUSES to
# start under NODE_ENV=production. Production value is `configured`.
CONSOLE_TENANT_IDENTITY=configured
# JSON assertion->tenant map. Credential material: inject it, do not commit it. Unset => refuse to start.
CONSOLE_TENANT_ASSERTIONS=
CONSOLE_SESSION_TTL_SECONDS=28800
CONSOLE_UPSTREAM_TIMEOUT_MS=10000

# ── Identity federation (P22) ───────────────────────────────────────────────────────────────────────
# NAMES ONLY. Every value below is injected by your secret store; a value written here is a leak, and
# scripts/deploy/check-no-plaintext-secrets.sh fails the build on one.
#
# The three store paths, and the property they share:
#   env      (dev)         the values below, injected by whatever put them in this environment
#   managed  (k8s)         the External Secrets Operator materialises them from AWS Secrets Manager /
#                          Vault, reached by an AMBIENT workload identity — no bootstrap secret
#   file     (air-gapped)  HEROS_SECRETS_SOURCE=file + HEROS_SECRETS_DIR, an operator-mounted path the
#                          pod is authorised for ambiently; read at the MOMENT OF USE, so a rotated
#                          file lands on the next sign-in with no restart
#
# `oidc` is the primary mechanism, `saml` the enterprise alternative, `configured` federates with
# nobody (open-core), and `dev` REFUSES to start under NODE_ENV=production.
CONSOLE_IDP_ISSUER=
CONSOLE_IDP_CLIENT_ID=
CONSOLE_IDP_CLIENT_SECRET=
# JSON array of absolute callback URLs. The FIRST entry is the one this deployment sends; the rest are
# additionally accepted (a hostname migration). A wildcard is refused at load — an allowlist with a
# wildcard is not an allowlist.
CONSOLE_IDP_REDIRECT_ALLOWLIST=
# The tenant mapping: strategy + issuer registrations. `verified_domains` hangs off the ISSUER entry,
# which is what stops IdP A from claiming tenant B's domain. Injected, never committed.
CONSOLE_IDP_TENANT_MAP=
# SAML 2.0 (the enterprise alternative).
CONSOLE_SAML_IDP_ENTITY_ID=
CONSOLE_SAML_SP_ENTITY_ID=
CONSOLE_SAML_IDP_METADATA_URL=
CONSOLE_SAML_ACS_ALLOWLIST=
CONSOLE_SAML_SP_PRIVATE_KEY=
# Where identity credentials are resolved from, reported on /api/health so the claim is checkable from
# the running system rather than from this file (secrets-baseline.md 1.1). `env` or `file`.
HEROS_SECRETS_SOURCE=env
HEROS_SECRETS_DIR=/var/run/secrets/heros

