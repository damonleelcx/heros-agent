# The agentd platform-service image (P19).
#
# The Go service is the platform's data-plane + control-plane API and the aggregator of /readyz. It is
# its own image for the same reason the console is (ADR-006): one process per container, so a dead
# process is a DEAD CONTAINER the orchestrator can see and restart — never a live container with a dead
# process inside it that a supervisor keeps reporting healthy.
#
# The toolchain is PINNED. A floating `golang:1.24` moves, and a build that cannot be reproduced is the
# property NFR9 exists to buy. Repin deliberately, in a commit, with the digest recorded.
FROM golang:1.24-bookworm AS build
WORKDIR /src

# Deps first, from go.mod/go.sum, so an edit to the source does not re-resolve the module graph — and
# so the graph cannot resolve differently between two builds of the same commit. `-mod=readonly` fails
# the build if go.mod would change, which is how a "reproducible" build stops being one.
COPY go.mod go.sum ./

# The module source is a BUILD ARG, and the default is the public one.
#
# 🔴 Why this exists: the build inherits none of the host's network configuration. A host that reaches
# modules through a regional mirror or a local HTTP proxy (127.0.0.1:… — which a container cannot reach
# by definition) builds fine on the command line and then dies in here with
# `dial tcp …:443: i/o timeout` against proxy.golang.org. That is not a broken Dockerfile to the person
# hitting it; it is "the product does not build", and it is the normal case behind a corporate proxy or
# a national firewall. deploy/scripts/up.sh passes the host's own GOPROXY through.
#
# This does NOT weaken reproducibility: GOPROXY changes where modules are FETCHED FROM, never what is
# accepted — go.sum still verifies every module hash, so a hostile mirror fails the build rather than
# poisoning it.
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
RUN go mod download

COPY . .
# CGO is ON — deliberately. agentd's discovery frontends link the tree-sitter C runtime via cgo
# (the same reason CI builds with CGO_ENABLED=1), so a CGO_ENABLED=0 build does not even LINK. The
# golang:1.24-bookworm build stage ships gcc, so this compiles cleanly. Trimpath + -buildvcs=false keep
# the build path and VCS state out of the binary, so the same commit builds byte-for-byte regardless of
# where it is checked out. The resulting binary links glibc, which the runtime base below provides.
ENV CGO_ENABLED=1
RUN go build -trimpath -buildvcs=false -mod=readonly -o /out/agentd ./cmd/agentd
# The consent-retention job ships in the SAME image, not its own. Retention is a legal obligation with a
# clock on it (P19 FR31), so it has to be deployable — and a second image would be a second digest, a
# second parity row and a second thing to forget to publish, to run a binary built from this same commit.
# One image, two entrypoints; the scheduled unit overrides the command.
RUN go build -trimpath -buildvcs=false -mod=readonly -o /out/legalretention ./cmd/legalretention

# An EMPTY data directory, created here so the runtime stage can COPY it with the right ownership.
#
# 🔴 This is load-bearing and it looks like nothing. The runtime base is distroless — no shell, so no
# `RUN mkdir` — and the process runs as `nonroot` on a READ-ONLY rootfs. When Docker creates a named
# volume for a path that does not exist in the image, it creates it EMPTY AND ROOT-OWNED, and nonroot
# then cannot create the ledger: `unable to open database file` (SQLITE_CANTOPEN), on every boot,
# forever. Seeding the path from the image is what makes Docker apply the image's ownership to the
# volume instead.
RUN mkdir -p /out/datadir

# ── Runtime ──────────────────────────────────────────────────────────────────
# distroless/base (NOT static): it carries glibc, which the cgo binary needs. Still no shell and no
# package manager — minimal attack surface. Nonroot: the service needs no root, so a container escape
# starts from the least useful possible position.
FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /app
COPY --from=build /out/agentd /app/agentd
COPY --from=build /out/legalretention /app/legalretention

# The data directory, owned by the user that has to write it. See the build stage's note: without this
# the named volume is root-owned and the nonroot process cannot create its ledger.
COPY --from=build --chown=nonroot:nonroot /out/datadir /var/lib/heros

# ── The calibration fixtures, which are the ACTIVATION GATE's input ──────────────────────────────
#
# 🔴 WITHOUT THESE THE OPERATOR CONSOLE CANNOT ACTIVATE AN AGENT DEFINITION, and the failure is a
# refusal rather than a crash: `calibrationRoot` looks for them, does not find them, no gate is built,
# and `Publisher.Activate` keeps refusing every `pending` version. Safe, and completely silent unless
# somebody reads the boot log — which is why the absence is logged there in words.
#
# They are REAL repositories, not test data in the sense of "only tests need it": D7's gate measures a
# candidate definition against nine trees whose true graphs are known, one of them MEASURED by the Go
# frontend itself. The relative paths under this root are the paths `calibrationSet` declares, so one
# root resolves all nine — see internal/launch/herosagentrehearsal.go.
#
# ⚠️ Two trees, from two packages, and both are needed: `herosagent/testdata` carries the purpose-built
# fixtures (the measured Go chain and the three near-misses) and `discovery/testdata` carries the
# per-language ones the set reuses. A copy of only the first loads five fixtures and fails the set,
# which is the anti-vacuity rule doing its job at deploy time.
COPY --from=build /src/internal/herosagent/testdata /usr/share/heros/calibration/internal/herosagent/testdata
COPY --from=build /src/internal/discovery/testdata /usr/share/heros/calibration/internal/discovery/testdata

# The data directory is a MOUNT POINT for a named volume, and its contents are DURABLE, not scratch. The
# SQLite ledger here holds tenant credentials, the registries, memory, the tool index and the inbox; the
# platform database holds lineage, specs, transforms, runs, eval results and consent. Both are user
# state under P19 FR22, and a deployment that mounts this at an emptyDir loses the first one on every
# rollout — which is exactly what the Kubernetes base did until Decision 9.
ENV HEROS_DATA_DIR=/var/lib/heros
ENV HEROS_LISTEN_ADDR=0.0.0.0:4321
USER nonroot:nonroot
EXPOSE 4321
# The OPERATOR admin API's own listener, when the deployment declares a federated operator console
# (ADMIN_API_LISTEN_ADDR, default 0.0.0.0:4311). Declared here because EXPOSE is what a reader consults
# to learn what this image serves, and one of these two ports must never be published.
#
# 🔴 Documentation only — EXPOSE publishes nothing. What keeps 4311 off the internet is that no Ingress
# names it and the NetworkPolicy admits only the admin BFF to it. Two mechanisms, neither of them this.
EXPOSE 4311

# The health endpoint the orchestrator probes and the same one every layer above reads. /healthz is
# liveness (the process serves); /readyz is readiness (dependencies reachable + the aggregated
# component verdict). The distroless base has no shell, so the probe is the binary itself.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD ["/app/agentd", "-healthcheck"]

ENTRYPOINT ["/app/agentd"]
