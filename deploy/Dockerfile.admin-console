# The P8 operator/admin console image (P19 admin-console-deploy, inheriting ADR-006).
#
# It inherits Dockerfile.console's posture EXACTLY — the operator console is not special-cased, it is
# the same two-container discipline applied to a second, higher-blast-radius surface:
#   • one process per container, so a dead BFF is a DEAD CONTAINER the orchestrator restarts, never a
#     live container with a dead process a supervisor keeps reporting healthy;
#   • the runtime PINNED by digest, because a build that cannot be reproduced is the property NFR9 buys;
#   • deps from the LOCKFILE (`npm ci`, not `npm install`), so the graph cannot resolve differently
#     between two builds of the same commit;
#   • the token/string/claim/bundle scans run INSIDE the build, so a bundle that would leak the admin
#     credential cannot be produced — a build gate, not a review habit;
#   • non-root, read_only rootfs at runtime, no-new-privileges — a container escape starts from the
#     least useful position possible for a surface that can suspend tenants and read cross-tenant data.
FROM node:24.18.1-bookworm-slim AS build
WORKDIR /app

COPY web/admin-console/package.json web/admin-console/package-lock.json ./
RUN npm ci --no-audit --no-fund

# The shared design tokens live OUTSIDE the console directories, beside both consoles, so neither can
# fork them quietly. The build needs them at the path the stylesheet imports.
COPY web/design-system ../design-system
COPY web/admin-console .

# 🔴 The origin gate is WORKSPACE-WIDE, and this image is not.
#
# `npm run scan:origins` runs web/design-system/scan-origins.mjs, which resolves its governed files
# relative to its OWN parent — so inside this image it looks for /console/... and /admin-console/...
# while the app itself lives at /app. Without these four files the build died with
# `ENOENT: /console/src/middleware.ts`, which is why this image had never been built successfully.
#
# They are copied rather than the gate being taught to skip a missing file, and that is the whole point:
# a scan that silently skips what it cannot find reports green for the file that went missing. Four
# small files keep the gate at FULL strength — it really does check both consoles' headers here.
COPY web/console/src/middleware.ts /console/src/middleware.ts
COPY web/console/next.config.mjs /console/next.config.mjs
COPY web/admin-console/src/middleware.ts /admin-console/src/middleware.ts
COPY web/admin-console/next.config.mjs /admin-console/next.config.mjs

# `npm run scan:ledger` (P26) checks every operator surface BOTH WAYS against the ledger that declares
# it, the deployed specs, and the P26 change's specs — all of which live outside web/ entirely. Same
# reasoning as the four files above: carried into the image so the gate runs, rather than made skippable
# so the gate passes. It is ~4MB of markdown in a build stage that is discarded, and it buys a build in
# which an operator surface cannot diverge from its declaration.
COPY openspec/operator-surface-ledger.md /openspec/operator-surface-ledger.md
COPY openspec/specs /openspec/specs
COPY openspec/changes/p26-operator-console-refresh/specs /openspec/changes/p26-operator-console-refresh/specs

RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:24.18.1-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs
COPY --from=build /app/public ./public

# Non-root. The operator console holds the ADMIN platform credential in its environment; a process that
# does not need root must not have it.
USER node

# 4310 — the operator BFF's origin, DISTINCT from the customer console's 4320. A different origin is a
# different deployment unit (P8 Decision 11); the isolation is the browser origin boundary, not a route.
EXPOSE 4310

# The health endpoint the orchestrator probes and the same one the platform's /readyz aggregates as
# `admin_console`. It reports the operator console's OWN liveness and configuration identity — it does
# not probe the admin API, because an admin-API latency spike must not read as a console outage.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4310/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "run", "start"]
