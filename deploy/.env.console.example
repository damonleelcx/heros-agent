# Example environment for deploy/docker-compose.console.yml (P9 §4.3).
#
# 🔴 THIS FILE CARRIES NO SECRETS AND NEVER WILL. It documents the NAMES the console reads and the
# shape of each value. The values come from the deployment's secret store, injected at start; a real
# credential committed to a repository outlives the moment it was valid, and it ships.
#
#   cp deploy/.env.console.example deploy/.env.console   # then fill from your secret store
#   docker compose -f deploy/docker-compose.console.yml --env-file deploy/.env.console up -d

# The platform image for this release. Pinned, not `latest`.
AGENTD_IMAGE=heros-agentd:0.0.0-replace-me

# The console image. Built from deploy/Dockerfile.console when absent.
CONSOLE_IMAGE=heros-console:0.0.0-replace-me

# The BFF's own credential for the platform API. The browser never receives it, it appears in no
# client bundle, no log line and no trace attribute, and `npm run scan:bundle` fails the build if it
# ever reaches a shipped chunk.
CONSOLE_PLATFORM_CREDENTIAL=

# The tenant identity seam (docs/adr/ADR-008-console-tenant-identity-seam.md).
#   password    an email address and a password, verified by the platform (P28, ADR-012). The value the
#               hosted product runs: a person creates their own account and needs nothing from an
#               operator. Needs no map below. Pair it with HEROS_SELF_SERVE_SIGNUP on the platform.
#   configured  the deployment's assertion -> tenant map, below. For an install whose people are added
#               by CONFIGURATION rather than by invitation. 🔴 An empty map here now REFUSES THE BOOT:
#               it authenticates nobody, and a console that starts and rejects every sign-in is
#               indistinguishable from a broken deployment.
#   oidc | saml federate against the customer's own identity provider (P22).
#   dev         accepts a declared tenant, for local work. REFUSES TO START when NODE_ENV=production.
CONSOLE_TENANT_IDENTITY=configured

# A JSON object mapping each accepted assertion to the tenant it resolves to. Credential material:
# inject it, do not commit it.
#   {"<assertion>":"<tenant_id>"}
CONSOLE_TENANT_ASSERTIONS=

# Session lifetime, seconds. Eight hours by default: long enough that a working day needs no second
# sign-in, short enough that a session on an unattended machine does not outlive its reason. A
# deployment whose policy is stricter shortens it here; a longer one has to be chosen deliberately.
CONSOLE_SESSION_TTL_SECONDS=28800

# The bound on every upstream call. A hung platform surfaces as a transport failure with actionable
# copy, never as an unbounded spinner.
CONSOLE_UPSTREAM_TIMEOUT_MS=10000

# ── Identity federation (P22) ───────────────────────────────────────────────────────────────────────
# NAMES ONLY. Every value below is injected by your secret store; a value written here is a leak, and
# scripts/deploy/check-no-plaintext-secrets.sh fails the build on one.
#
# The three store paths, and the property they share:
#   env      (dev)         the values below, injected by whatever put them in this environment
#   managed  (k8s)         the External Secrets Operator materialises them from AWS Secrets Manager /
#                          Vault, reached by an AMBIENT workload identity — no bootstrap secret
#   file     (air-gapped)  HEROS_SECRETS_SOURCE=file + HEROS_SECRETS_DIR, an operator-mounted path the
#                          pod is authorised for ambiently; read at the MOMENT OF USE, so a rotated
#                          file lands on the next sign-in with no restart
#
# `oidc` is the primary mechanism, `saml` the enterprise alternative, `configured` federates with
# nobody (open-core), and `dev` REFUSES to start under NODE_ENV=production.
CONSOLE_IDP_ISSUER=
CONSOLE_IDP_CLIENT_ID=
CONSOLE_IDP_CLIENT_SECRET=
# JSON array of absolute callback URLs. The FIRST entry is the one this deployment sends; the rest are
# additionally accepted (a hostname migration). A wildcard is refused at load — an allowlist with a
# wildcard is not an allowlist.
CONSOLE_IDP_REDIRECT_ALLOWLIST=
# The tenant mapping: strategy + issuer registrations. `verified_domains` hangs off the ISSUER entry,
# which is what stops IdP A from claiming tenant B's domain. Injected, never committed.
CONSOLE_IDP_TENANT_MAP=
# SAML 2.0 (the enterprise alternative).
CONSOLE_SAML_IDP_ENTITY_ID=
CONSOLE_SAML_SP_ENTITY_ID=
CONSOLE_SAML_IDP_METADATA_URL=
CONSOLE_SAML_ACS_ALLOWLIST=
CONSOLE_SAML_SP_PRIVATE_KEY=
# Where identity credentials are resolved from, reported on /api/health so the claim is checkable from
# the running system rather than from this file (secrets-baseline.md 1.1). `env` or `file`.
HEROS_SECRETS_SOURCE=env
HEROS_SECRETS_DIR=/var/run/secrets/heros


# Published ports.
AGENTD_PORT=4321
CONSOLE_PORT=4320
