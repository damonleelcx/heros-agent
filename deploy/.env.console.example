# Example environment for deploy/docker-compose.console.yml (P9 §4.3).
#
# 🔴 THIS FILE CARRIES NO SECRETS AND NEVER WILL. It documents the NAMES the console reads and the
# shape of each value. The values come from the deployment's secret store, injected at start; a real
# credential committed to a repository outlives the moment it was valid, and it ships.
#
#   cp deploy/.env.console.example deploy/.env.console   # then fill from your secret store
#   docker compose -f deploy/docker-compose.console.yml --env-file deploy/.env.console up -d

# The platform image for this release. Pinned, not `latest`.
AGENTD_IMAGE=heros-agentd:0.0.0-replace-me

# The console image. Built from deploy/Dockerfile.console when absent.
CONSOLE_IMAGE=heros-console:0.0.0-replace-me

# The BFF's own credential for the platform API. The browser never receives it, it appears in no
# client bundle, no log line and no trace attribute, and `npm run scan:bundle` fails the build if it
# ever reaches a shipped chunk.
CONSOLE_PLATFORM_CREDENTIAL=

# The tenant identity seam (docs/adr/ADR-008-console-tenant-identity-seam.md).
#   configured  the deployment's assertion -> tenant map, below. The only production value.
#   dev         accepts a declared tenant, for local work. REFUSES TO START when NODE_ENV=production.
CONSOLE_TENANT_IDENTITY=configured

# A JSON object mapping each accepted assertion to the tenant it resolves to. Credential material:
# inject it, do not commit it.
#   {"<assertion>":"<tenant_id>"}
CONSOLE_TENANT_ASSERTIONS=

# Session lifetime, seconds. Eight hours by default: long enough that a working day needs no second
# sign-in, short enough that a session on an unattended machine does not outlive its reason. A
# deployment whose policy is stricter shortens it here; a longer one has to be chosen deliberately.
CONSOLE_SESSION_TTL_SECONDS=28800

# The bound on every upstream call. A hung platform surfaces as a transport failure with actionable
# copy, never as an unbounded spinner.
CONSOLE_UPSTREAM_TIMEOUT_MS=10000

# Published ports.
AGENTD_PORT=4321
CONSOLE_PORT=4320
