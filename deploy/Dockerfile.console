# The P9 customer console image (ADR-006).
#
# WHY THIS IS ITS OWN IMAGE, AND NOT A SECOND PROCESS IN THE agentd IMAGE:
# a supervisor inside one container makes the container's liveness a LIE ABOUT ITS CONTENTS. If the
# Node process dies and the supervisor keeps the container alive — or restarts it in a tight loop —
# the orchestrator sees a healthy container, the restart policy never fires, the rollout never fails,
# and the only symptom is that the surface users reach is down. That is exactly the failure mode
# `health-signal-surface` names. Two containers make a dead process a DEAD CONTAINER, which every
# layer above already knows how to see and act on. See docs/adr/ADR-006-console-deploy-packaging.md.
#
# The runtime is PINNED. A floating `node:22` tag moves, and a build that cannot be reproduced is the
# property NFR9 exists to buy. Repin deliberately, in a commit, with the digest recorded.
FROM node:24.18.1-bookworm-slim AS build
WORKDIR /app

# Deps first, from the LOCKFILE, so an edit to the source does not re-resolve the dependency graph —
# and so the graph cannot resolve differently between two builds of the same commit. `npm ci` fails if
# the lockfile and package.json disagree; `npm install` would quietly reconcile them, which is how a
# "reproducible" build stops being one.
COPY web/console/package.json web/console/package-lock.json ./
RUN npm ci --no-audit --no-fund

# The shared design tokens live OUTSIDE the console directory, beside both consoles, so neither can
# fork them quietly. The build needs them at the path the stylesheet imports.
COPY web/design-system ../design-system
COPY web/console .

# 🔴 The origin gate is WORKSPACE-WIDE, and this image is not. scan-origins.mjs resolves its governed
# files relative to its OWN parent, so inside this image it looks for /console/... and /admin-console/...
# while the app lives at /app. Copied rather than taught to skip: a scan that silently skips what it
# cannot find reports green for the very file that went missing. See Dockerfile.admin-console, where the
# same omission is what made that image unbuildable.
COPY web/console/src/middleware.ts /console/src/middleware.ts
COPY web/console/next.config.mjs /console/next.config.mjs
COPY web/admin-console/src/middleware.ts /admin-console/src/middleware.ts
COPY web/admin-console/next.config.mjs /admin-console/next.config.mjs

# The build runs the three fences — token scan, string scan, claim scan — then compiles, then scans
# the shipped client bundle for credential material and priced literals. A bundle that would leak
# cannot be produced, because the scan is a build step rather than a review habit.
RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────
# Same pinned base, so the Node the bundle was built against is the Node that runs it.
FROM node:24.18.1-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs

# P23 · ADR-011 — the legal and documentation corpus ships IN THIS IMAGE.
#
# This is the deployment model, not a packaging convenience: content-as-code means a bad copy change is
# reverted by redeploying the previous console image (no migration, no platform restart), and it means an
# air-gapped P19 deployment serves byte-identical documents with no egress at all.
#
# The reading routes render per request (the nonce-based CSP cannot be satisfied by build-time HTML), so
# these files are read at RUNTIME and this COPY is load-bearing. Without it every /docs and /legal route
# 404s in the container while passing every test on a developer's machine — which is exactly the class of
# failure `docs`/`legal` exist to prevent, so the air-gapped parity check (task 11.3) asserts it.
COPY --from=build /app/content ./content

# Non-root. The console holds the platform credential in its environment; a process that does not need
# root must not have it, so a container escape starts from the least useful possible position.
USER node

EXPOSE 4320

# The health endpoint the orchestrator probes, and the same one the platform's /readyz aggregates. It
# reports the console's OWN liveness and configuration identity — it does not probe the platform,
# because a platform latency spike must not read as a console outage.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4320/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "run", "start"]
