# Example environment for deploy/docker-compose.admin-console.yml (P19 admin-console-deploy).
#
# 🔴 THIS FILE CARRIES NO SECRETS AND NEVER WILL. It documents the NAMES the operator console reads and
# the shape of each value. Secret values come from the deployment's secret store, injected at start.
#
#   cp deploy/.env.admin-console.example deploy/.env.admin-console   # then fill from your secret store

# The operator console image (built from deploy/Dockerfile.admin-console when absent).
ADMIN_CONSOLE_IMAGE=ghcr.io/heros-foreal/heros-admin-console:0.0.0-replace-me

# Published port on the host — the operator ORIGIN. Distinct from the customer console's (4320) by
# construction: a different origin is what makes the two consoles' cookie jars disjoint.
ADMIN_CONSOLE_PORT=4310

# The operator BFF's OWN credential for the admin API. It is DISTINCT from CONSOLE_PLATFORM_CREDENTIAL
# — the two BFFs cannot act with each other's credential. The browser never receives it; it appears in
# no client bundle, log line or trace attribute; `npm run scan:bundle` fails the build if it reaches a
# shipped chunk. 🔴 Inject from your secret store. Unset => the BFF refuses to serve.
ADMIN_PLATFORM_CREDENTIAL=

# The identity mode (docs/adr/ADR-008-console-tenant-identity-seam.md).
#   configured  only the deployment's real admin IdP (SSO + MFA) is accepted. The only production value.
#   dev         accepts fixture SSO subjects for local work. REFUSES TO START when NODE_ENV=production.
ADMIN_IDENTITY_MODE=configured

# The operator IdP's callback URL, absolute, on the OPERATOR origin (:4310 by default).
# 🔴 Pointing this at the customer origin would land an operator's assertion in the customer console's
# cookie jar — the one boundary this whole second-unit design exists to keep (P19 Decision 5).
ADMIN_IDP_CALLBACK_URL=

# ── Analytics & error monitoring (P24): deliberately NOT configurable here ──────────────────────────
# The reporting switches are absent from every deployment manifest and every .env example on purpose
# (P24 task 7.4). An empty slot is one `--set` from being filled, in a file a customer edits without
# reading — and those integrations belong to the platform's own hosted deployment, configured from its
# own environment, not to a customer's install. Nothing to fill in here, by design.

# Which build this is, on the release surface. A name, never a price or a plan tier.
HEROS_EDITION=open-core
HEROS_VERSION=
