# The COMPILE WORKER: agentd, plus a Go toolchain, for running the P5.5 build gate.
#
# WHY THIS IS A SEPARATE IMAGE FROM Dockerfile.agentd
#
# The build gate compiles a CUSTOMER'S repository (internal/hostedcompile/buildgate.go). That needs a
# toolchain, and the API server's runtime image is `gcr.io/distroless/base-debian12:nonroot` on purpose:
# no shell, no package manager, minimal attack surface. Adding a compiler to the image that terminates
# public traffic would trade that away for every request path, to serve one action.
#
# So the compiler lives here. It is the SAME agentd binary — one build, two images, exactly as
# Dockerfile.discover does — so there is no second implementation to keep in step and no RPC contract to
# version. The two images differ in what they carry and in the posture they are run under, not in what
# they do.
#
# 🔴 WHAT THIS IMAGE ALONE DOES NOT GIVE YOU
#
# The gate requires an isolate that DENIES NETWORK EGRESS and scopes the filesystem, and it fails closed
# without one. Neither is a property of an image: only the runtime spec can provide them, which is why
# `HEROS_SANDBOX_CONTAINED` is a declaration an operator makes about the container, not something this
# Dockerfile can set. Running this image WITHOUT that posture and setting the variable anyway is the one
# mistake the fail-closed design exists to prevent — it would run a customer's build with network access.
#
# ⚠️ And a worker that talks to Postgres is not network-denied. That is the honest tension in this
# topology, and it is not resolved by this file: the compile step must reach the database to read
# proposals and write diffs, so the CONTAINER cannot be `network_mode: none`. Closing it properly means
# the isolate denying egress per-child (a Linux network namespace on the compiler process itself), which
# internal/sandbox does not yet implement — SubprocessEnforcer reports NetworkDeny=false and there is no
# platform enforcer above it. Until that exists, a deployment that sets HEROS_SANDBOX_CONTAINED here is
# claiming a restriction it has only partially: the filesystem scope and the credential scrub are real,
# the egress denial is the container's policy rather than the isolate's.
#
# The supported posture today is therefore: run this image with an egress-denied network policy that
# permits ONLY the database, and understand that the isolate inherits that policy rather than tightening
# it. See deploy/README.md.

FROM golang:1.24-bookworm AS build
WORKDIR /src
ENV CGO_ENABLED=1 GOFLAGS=-mod=mod
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -o /out/agentd ./cmd/agentd

# ── Runtime ──────────────────────────────────────────────────────────────────
# The full Go image, NOT distroless: the whole point of this image is that `go build` can run. It is
# also why this image must never terminate public traffic.
FROM golang:1.24-bookworm
WORKDIR /app
COPY --from=build /out/agentd /app/agentd

# A non-root uid, pinned here and again in the compose spec. The compile worker runs a customer's build;
# it needs no root, and a container escape should start from the least useful possible position.
RUN useradd --uid 65532 --create-home --shell /usr/sbin/nologin heros \
 && mkdir -p /var/lib/heros && chown heros:heros /var/lib/heros

# GOFLAGS is NOT set to -mod=mod here: the build gate chooses -mod=vendor or -mod=mod per repository,
# from whether the customer's tree is vendored, and an image-wide default would override that decision
# for every workflow. GOTOOLCHAIN=local pins the compiler to the one in this image — a `toolchain`
# directive in a customer's go.mod must not make this container download and run a different compiler.
ENV GOTOOLCHAIN=local
ENV HEROS_GO_TOOLCHAIN=/usr/local/go/bin/go
ENV HEROS_DATA_DIR=/var/lib/heros
ENV HEROS_LISTEN_ADDR=0.0.0.0:4321

USER 65532:65532
EXPOSE 4321
ENTRYPOINT ["/app/agentd"]
