# Secrets. 🔴 Never commit a provider key: a key in git history is a key that has
# leaked, and rotating it is the only remedy. The loader reads .env.local at
# runtime; the file is created by the operator, never by the build.
.env
.env.local
*.key

# Build artefacts
/bin/
/dist/
*.cover

# macOS
.DS_Store

# Local scratch
/cmd/livecheck/out.txt
