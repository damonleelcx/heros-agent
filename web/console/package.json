{
  "name": "heros-console",
  "version": "0.1.0",
  "private": true,
  "description": "P9 customer console — the tenant-facing dashboard and its BFF, plus the public home page.",
  "scripts": {
    "dev": "next dev --port 4320",
    "build": "npm run scan:tokens && npm run scan:strings && npm run scan:markup && npm run scan:claims && next build && npm run scan:bundle",
    "start": "next start --port 4320",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "scan:tokens": "node scripts/scan-tokens.mjs",
    "scan:strings": "node scripts/scan-strings.mjs",
    "scan:claims": "node scripts/scan-claims.mjs",
    "scan:fields": "node scripts/scan-fields.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "accept": "node scripts/accept.mjs",
    "scan:markup": "node scripts/scan-markup.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "lucide-react": "0.487.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
