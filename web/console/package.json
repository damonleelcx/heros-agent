{
  "name": "heros-console",
  "version": "0.1.0",
  "private": true,
  "description": "P9 customer console \u2014 the tenant-facing dashboard and its BFF, plus the public home page.",
  "scripts": {
    "dev": "next dev --port 4320",
    "build": "npm run gen && npm run scan:tokens && npm run scan:strings && npm run scan:markup && npm run scan:claims && npm run scan:docs && next build && npm run scan:bundle",
    "start": "next start --port 4320",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "scan:tokens": "node scripts/scan-tokens.mjs",
    "scan:strings": "node scripts/scan-strings.mjs",
    "scan:claims": "node scripts/scan-claims.mjs",
    "scan:fields": "node scripts/scan-fields.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "accept": "node scripts/accept.mjs",
    "scan:markup": "node scripts/scan-markup.mjs",
    "dev:p21": "CONSOLE_TENANT_IDENTITY=configured CONSOLE_TENANT_ASSERTIONS='{\"local-dev-assertion\":\"cus_nousresearch\"}' CONSOLE_PLATFORM_CREDENTIAL=local-dev-credential-not-a-secret PLATFORM_API_BASE=http://127.0.0.1:4401 next dev --port 4327",
    "dev:sso": "node scripts/dev-sso.mjs",
    "dev:browser": "CONSOLE_TENANT_IDENTITY=configured CONSOLE_TENANT_ASSERTIONS='{\"local-dev-assertion\":\"tenant-hermes\"}' CONSOLE_PLATFORM_CREDENTIAL=local-dev-credential-not-a-secret PLATFORM_API_BASE=http://127.0.0.1:4399 next dev --port 4320",
    "gen:search-index": "node scripts/gen-search-index.mjs",
    "gen:slug-manifest": "node scripts/gen-slug-manifest.mjs",
    "gen": "npm run gen:release-assets && npm run gen:cli-reference && npm run gen:schema-reference && npm run gen:install-content && npm run gen:slug-manifest && npm run gen:search-index",
    "gen:release-assets": "NODE_USE_ENV_PROXY=1 node scripts/gen-release-assets.mjs",
    "gen:cli-reference": "node scripts/gen-cli-reference.mjs",
    "gen:schema-reference": "node scripts/gen-schema-reference.mjs",
    "gen:install-content": "node scripts/gen-install-content.mjs",
    "scan:docs-claims": "node scripts/scan-docs-claims.mjs",
    "scan:cli": "node scripts/scan-cli.mjs",
    "scan:api": "node scripts/scan-api.mjs",
    "scan:metric": "node scripts/scan-metric.mjs",
    "scan:links": "node scripts/scan-links.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:content": "node scripts/scan-content.mjs",
    "scan:install": "node scripts/scan-install.mjs",
    "scan:repo-link": "NODE_USE_ENV_PROXY=1 node scripts/scan-repo-link.mjs",
    "scan:docs": "npm run scan:content && npm run scan:secrets && npm run scan:docs-claims && npm run scan:cli && npm run scan:api && npm run scan:metric && npm run scan:install && npm run scan:links && npm run scan:repo-link"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "lucide-react": "0.487.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
