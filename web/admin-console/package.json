{
  "name": "heros-admin-console",
  "version": "0.1.0",
  "private": true,
  "description": "P8 operator console \u2014 a separate Next.js application on its own origin with its own BFF.",
  "scripts": {
    "dev": "next dev --port 4310",
    "build": "npm run scan:tokens && next build && npm run scan:bundle",
    "start": "next start --port 4310",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "scan:tokens": "node scripts/scan-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "baseline": "node scripts/visual-baseline.mjs",
    "baseline:update": "node scripts/visual-baseline.mjs --update"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2"
  }
}
